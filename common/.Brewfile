# Set default install location for cask apps
cask_args appdir: "/Applications"

# CLI Tools (brew)
brew "aria2"
brew "autoconf"
brew "automake"
brew "binutils"
brew "bash"
brew "bzip2"
brew "coreutils"
brew "curl"
brew "findutils"
brew "gcc"
brew "gh"
brew "git"
brew "git-lfs"
brew "gnu-tar"
brew "gptfdisk"
brew "grep"
brew "gzip"
brew "imagemagick"
brew "make"
brew "mas"
brew "pbzip2"
brew "pigz"
brew "readline"
brew "rename"
brew "rsync"
brew "sox"
brew "sratoolkit"
brew "tcl-tk"
brew "unzip"
brew "wget"
brew "xz"

# Libraries (brew)
brew "cairo"
brew "gettext"
brew "jpeg"
brew "libiconv"
brew "libpng"
brew "libtiff"
brew "libxml2"
brew "lmdb"
brew "openblas"
brew "openssl@3"
brew "pango"
brew "pcre2"
brew "pkgconf"
brew "zlib"

